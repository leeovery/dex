            ],
            "key": "8samg",
            "text": "🧠 Jev is TypeSafe AI's System One model: you provide information and predefined questions, it returns typed answers with probabilities. It cannot write your briefing, generate code, or explain its reasoning in prose. TypeSafe's launch essay",
            "type": "unstyled"
          },
