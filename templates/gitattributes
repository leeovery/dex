state/inbox/*.jpeg filter=lfs diff=lfs merge=lfs -text
state/inbox/*.png filter=lfs diff=lfs merge=lfs -text
state/inbox/*.gif filter=lfs diff=lfs merge=lfs -text
state/inbox/*.heic filter=lfs diff=lfs merge=lfs -text
enrichment/**/media-* filter=lfs diff=lfs merge=lfs -text
