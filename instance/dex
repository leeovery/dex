#!/bin/sh
# dex engine dispatcher — run from the instance root.
#   bin/dex normalize | enrich [run|status|transcribe|fetch|compact|mark|pass|place|item] | lint [--write] | map | exclude <file.json> | inbox [ensure] | sync | render --file <payload> | new <name> | issue --file <payload.json> | serve --instance <path> | connect --instance <path> [--client <name>]
# Runs the release pinned in .dex-engine-pin, read from THIS shim's instance
# root and never from the working directory: chat clients spawn `serve` from
# wherever the session happens to be, and a pin looked up there is never
# found. The line is `<tag> <commit>`, written by sync. The commit is what
# uvx is given, because uv re-resolves a tag on every launch — seconds of
# release lookup each time — and never re-resolves a full one. The tag
# serves for a pin an older sync wrote; no pin at all tracks main, until the
# first tag-aware sync pins one.
# The usage check comes BEFORE the shift: shift is a POSIX special builtin,
# and with no positional parameters dash exits the script on the spot, so a
# usage message after it is unreachable there.
cmd=${1-}
[ -n "$cmd" ] || { echo "usage: bin/dex <normalize|enrich|lint|map|exclude|inbox|sync|render|new|issue|serve|connect> [args]"; exit 1; }
shift
ref=main
pin_file=$(dirname "$0")/../.dex-engine-pin
if [ -f "$pin_file" ]; then
  # Field-split on space/CR/tab so hand-edited pins (CRLF, stray blanks)
  # still yield a clean uvx ref; read strips nothing on its own.
  pin=; field=; rest=
  IFS=$(printf ' \r\t') read -r pin field rest < "$pin_file" || :
  if [ -n "$pin" ]; then
    ref=$pin
    # Only a full 40-hex commit is launched by; anything else in that field
    # is a hand edit, and the tag still resolves.
    case $field in
      *[!0-9a-f]*|'') ;;
      *) [ ${#field} -eq 40 ] && ref=$field ;;
    esac
  fi
fi
exec uvx --from "git+https://github.com/leeovery/dex@$ref" "dex-$cmd" "$@"
